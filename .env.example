# ==========================================================================
# PROSPECTOR IA — Exemplo de variáveis de ambiente.
# Copie este arquivo para ".env" e ajuste os valores. NUNCA versionar o .env.
# Nenhum segredo deve ser enviado ao repositório.
# ==========================================================================

APP_NAME="Prospector IA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=America/Recife

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --------------------------------------------------------------------------
# Banco de dados — produção recomendada: MySQL 8.
# Para testes/desenvolvimento leve é possível usar sqlite.
# --------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=prospector
DB_USERNAME=prospector
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Fila padrão compatível com hospedagem comum (usa o próprio banco).
# Troque por "redis" quando o Redis estiver disponível.
QUEUE_CONNECTION=database
CACHE_STORE=database

# Redis (opcional — para filas e cache quando disponível)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --------------------------------------------------------------------------
# E-mail (SMTP autenticado ou API). Em produção nunca use "log".
# --------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contato@exemplo.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Provedor de pesquisa de empresas.
# null = "Conector não configurado" (cadastro manual e CSV continuam ativos).
# google = Google Places API (New). Exige projeto, faturamento e chave.
# --------------------------------------------------------------------------
SEARCH_PROVIDER=null
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_TIMEOUT_SECONDS=15
GOOGLE_PLACES_RETRY_TIMES=2
GOOGLE_PLACES_PAGE_SIZE=20
# Teto de segurança de custo por pesquisa (resultados). Documente a quota.
GOOGLE_PLACES_MAX_RESULTS_PER_JOB=100

# --------------------------------------------------------------------------
# Provedor de IA (API compatível com OpenAI Chat Completions).
# null = geração por IA indisponível; a revisão manual continua funcionando.
# --------------------------------------------------------------------------
AI_PROVIDER=null
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_RETRY_TIMES=1

# --------------------------------------------------------------------------
# WhatsApp Business Platform (oficial Meta). Só funciona com credenciais
# válidas, opt-in e templates aprovados. Sem isto, o envio fica bloqueado.
# --------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# --------------------------------------------------------------------------
# Instagram/Facebook via Meta Graph API (somente endpoints autorizados).
# --------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0

# --------------------------------------------------------------------------
# LGPD / retenção (meses). 0 = manter indefinidamente até exclusão manual.
# --------------------------------------------------------------------------
RETENTION_TRANSIENT_PLACE_DATA_DAYS=30
RETENTION_LEAD_MONTHS=36
RETENTION_MESSAGE_LOG_MONTHS=24
RETENTION_AUDIT_LOG_MONTHS=60

# Limite de mensagens externas por usuário por dia (proteção anti-spam).
DAILY_MESSAGE_LIMIT=100

VITE_APP_NAME="${APP_NAME}"
